# rules/config_a_10.rules — generated by scripts/rule_generator.py 10
# 10 rules: BEST port 80 = rule 4, MIDDLE port 5500 = rule 7, WORST port 9900 = rule 10, MISS port 9999 = DROP
*filter
:FW_FORWARD - [0:0]
:FILTER_DROP - [0:0]
:ALLOW - [0:0]
-A FW_FORWARD -s 10.8.50.180/32 -p tcp -m tcp --dport 22 -j ACCEPT
